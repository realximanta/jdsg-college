<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude secure preferences from cloud backup -->
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude secure preferences from device-to-device transfer -->
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
